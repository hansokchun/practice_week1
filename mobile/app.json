{
  "expo": {
    "name": "Ikkyee",
    "slug": "ikkyee-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ikkyee",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ikkyee.mobile"
    },
    "android": {
      "package": "com.ikkyee.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Ikkyee to read your travel photos.",
          "savePhotosPermission": "Allow Ikkyee to save travel photos.",
          "isAccessMediaLocationEnabled": true,
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": ["photo", "video"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
