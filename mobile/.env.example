# Public client configuration only. Never place service-role keys here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Build-time native map keys. Register restricted iOS and Android keys together.
GOOGLE_MAPS_ANDROID_API_KEY=replace-with-android-restricted-key
GOOGLE_MAPS_IOS_API_KEY=replace-with-ios-restricted-key
# Optional only for a development HTTPS tunnel. Preview and production use fixed Pages origins.
EXPO_PUBLIC_LINK_ORIGIN=
