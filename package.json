{
  "name": "ikkyee",
  "version": "1.0.0",
  "description": "Ikkyee - photo-based travel journal website",
  "private": true,
  "scripts": {
    "dev": "vite",
    "test": "node --test",
    "build": "vite build",
    "preview": "vite preview",
    "perf:budget": "npm run build && node scripts/check-performance-budget.mjs",
    "backup:check": "bash scripts/backup-supabase.sh --check",
    "backup:db": "bash scripts/backup-supabase.sh",
    "restore:check": "bash scripts/restore-supabase-backup.sh --check",
    "restore:db": "bash scripts/restore-supabase-backup.sh",
    "schema:pull": "bash scripts/pull-supabase-schema.sh",
    "storage:preflight:check": "bash scripts/check-storage-cutover-readiness.sh --check",
    "storage:preflight": "bash scripts/check-storage-cutover-readiness.sh",
    "release:rehearse": "bash scripts/rehearse-public-beta-release.sh",
    "cf:deploy:dev": "npm run build && npx wrangler pages deploy dist --project-name practice-week1 --branch dev",
    "cf:deploy:main": "npm run build && npx wrangler pages deploy dist --project-name practice-week1 --branch main"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hansokchun/practice_week1.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hansokchun/practice_week1/issues"
  },
  "homepage": "https://github.com/hansokchun/practice_week1#readme",
  "devDependencies": {
    "vite": "^8.0.10"
  }
}
